; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Phi Tiêu Dịch Chuyển"
config/description="Vượt 20 ải - Ném phi tiêu - Dịch chuyển - Tiêu diệt Boss! Game 2D top-down với hướng dẫn chi tiết + Multiplayer online. v4.2: Sửa UI online đồng bộ với sảnh chờ, sửa lỗi nút bấm đóng băng, yêu cầu đăng nhập trước khi vào Multiplayer. Game developed by Hieu Louis."
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/version="4.2"
config/icon="res://icon.svg"

[autoload]

SettingsManager="*res://scripts/settings_manager.gd"
GameManager="*res://scripts/game_manager.gd"
AudioManager="*res://scripts/audio_manager.gd"
CharacterData="*res://scripts/character_data.gd"
I18N="*res://scripts/i18n.gd"
StageManager="*res://scripts/stage_manager.gd"
SpeciesData="*res://scripts/species_data.gd"
ProgressionManager="*res://scripts/progression_manager.gd"
WorldManager="*res://scripts/world_manager.gd"
TutorialManager="*res://scripts/tutorial_manager.gd"
AccountManager="*res://scripts/account_manager.gd"
MultiplayerManager="*res://scripts/multiplayer_manager.gd"
LoginRouter="*res://scripts/login_router.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

